android_app {
    name: "OplusEuicc",
    overrides: ["EuiccPolicy"],

    srcs: ["src/**/*.kt"],

    sdk_version: "current",
    product_specific: true,
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.lineageos.euicc.xml",

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
    required: [
        "hidden-api-whitelist-org.lineageos.euicc.xml",
    ],
}

