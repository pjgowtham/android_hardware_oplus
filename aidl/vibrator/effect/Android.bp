cc_library_shared {
    name: "libqtivibratoreffect.oplus",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: ["effect.cpp"],
    header_libs: ["libqtivibratoreffect_headers"],
    shared_libs: ["android.hardware.vibrator-V2-ndk"],
    include_dirs: select(soong_config_variable("OPLUS_LINEAGE_VIBRATOR_EFFECT", "INCLUDE_DIR"), {
        any @ flag_val: [flag_val],
        default: [],
    }),
}
